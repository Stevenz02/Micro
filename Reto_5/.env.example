# ============================================================
# Reto 5 - Variables de entorno (copiar a .env: Copy-Item .env.example .env)
# Todos los valores son SOLO para uso académico/local.
# ============================================================

# --- Gateway (única entrada HTTP publicada al host) ---
GATEWAY_PORT=8080
GATEWAY_REQUEST_TIMEOUT_SECONDS=20

# --- JWT (compartido por auth-service y api-gateway, HS256) ---
# Clave simétrica documentada por propósitos académicos (mínimo 32 bytes).
JWT_SECRET=reto5-uniquindio-clave-academica-hs256-no-usar-en-produccion
# Vida del access token (60-3600 s) y del token de activación/recuperación (900-3600 s)
JWT_ACCESS_TTL_SECONDS=900
JWT_RESET_TTL_SECONDS=1800

# --- Administrador semilla (lo crea auth-service al arrancar, rol ADMIN, estado ACTIVA) ---
# Contraseña de demo: AdminRrhh2026  (en BD solo se guarda el hash bcrypt de abajo)
# El hash va entre COMILLAS SIMPLES: sin ellas Docker Compose interpreta los "$" como variables.
# Para generar otro: docker compose run --rm --no-deps auth-service python hash_admin.py
ADMIN_EMPLOYEE_ID=ADMIN
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD_HASH='$2b$12$XC8mUFbtuP9TNtHG7XWUDeIwzcnfRNQIn0GW1V7GjWzjZ0d6dttpC'

# --- Scheduler de vacaciones (segundos entre ciclos, 1-3600) ---
VACACIONES_SCHEDULER_INTERVAL_SECONDS=60

# --- RabbitMQ ---
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=rrhh
RABBITMQ_PASSWORD=rrhh_local_demo

# --- Bases de datos (una por servicio) ---
DB_EMPLEADOS_NAME=empleados_db
DB_EMPLEADOS_USER=empleados_user
DB_EMPLEADOS_PASSWORD=empleados_local_demo
DB_DEPARTAMENTOS_NAME=departamentos_db
DB_DEPARTAMENTOS_USER=departamentos_user
DB_DEPARTAMENTOS_PASSWORD=departamentos_local_demo
DB_PERFILES_NAME=perfiles_db
DB_PERFILES_USER=perfiles_user
DB_PERFILES_PASSWORD=perfiles_local_demo
DB_NOTIFICACIONES_NAME=notificaciones_db
DB_NOTIFICACIONES_USER=notificaciones_user
DB_NOTIFICACIONES_PASSWORD=notificaciones_local_demo
DB_VACACIONES_NAME=vacaciones_db
DB_VACACIONES_USER=vacaciones_user
DB_VACACIONES_PASSWORD=vacaciones_local_demo
DB_AUTH_NAME=auth_db
DB_AUTH_USER=auth_user
DB_AUTH_PASSWORD=auth_local_demo

# --- Resiliencia empleados -> departamentos (Reto 3) ---
DEPARTAMENTOS_TIMEOUT_SECONDS=2
DEPARTAMENTOS_MAX_RETRIES=3
DEPARTAMENTOS_BACKOFF_SECONDS=1
DEPARTAMENTOS_CB_FAIL_MAX=3
DEPARTAMENTOS_CB_RESET_TIMEOUT_SECONDS=30
PENDIENTES_RECONCILIATION_INTERVAL_SECONDS=15
