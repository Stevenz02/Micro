# Valores publicos de demostracion. No guardar credenciales reales.

# API Gateway
GATEWAY_PORT=8080
EMPLEADOS_URL=http://empleados-service:8081
DEPARTAMENTOS_URL=http://departamentos-service:8082
GATEWAY_REQUEST_TIMEOUT_SECONDS=5

# Empleados
DB_EMPLEADOS_NAME=empleados_db
DB_EMPLEADOS_USER=empleados_user
DB_EMPLEADOS_PASSWORD=empleados_local_demo
DEPARTAMENTOS_SERVICE_URL=http://departamentos-service:8082
DEPARTAMENTOS_TIMEOUT_SECONDS=2
DEPARTAMENTOS_MAX_RETRIES=3
DEPARTAMENTOS_BACKOFF_SECONDS=1
DEPARTAMENTOS_CB_FAIL_MAX=3
DEPARTAMENTOS_CB_RESET_TIMEOUT_SECONDS=30

# Departamentos
DB_DEPARTAMENTOS_NAME=departamentos_db
DB_DEPARTAMENTOS_USER=departamentos_user
DB_DEPARTAMENTOS_PASSWORD=departamentos_local_demo
