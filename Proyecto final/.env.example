# Configuración NO sensible del ecosistema. Uso:  cp .env.example .env
# Este archivo no contiene (ni debe contener) ningún secreto: esos se generan con
# scripts/setup-secrets.sh en la carpeta secrets/, que Git ignora.

# Perfiles de Compose activos. "ci" incluye Jenkins, SonarQube y el registry en el mismo
# `docker compose up --build`. Déjelo vacío para arrancar sin CI (ahorra ~3 GB de RAM).
COMPOSE_PROFILES=ci

# Puertos publicados en localhost
GATEWAY_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ZIPKIN_PORT=9411
RABBITMQ_MANAGEMENT_PORT=15672
JENKINS_PORT=8090
JENKINS_AGENT_PORT=50000
SONAR_PORT=9000
REGISTRY_PORT=5001

# Identidades y nombres (NO son secretos). Las contraseñas, el secreto JWT, el hash del
# administrador y el webhook de alertas viven como archivos en secrets/ (Docker Compose Secrets),
# generados por scripts/setup-secrets.sh. Plantillas de referencia: secrets.example/
RABBITMQ_USER=rrhh
GRAFANA_ADMIN_USER=admin
JENKINS_ADMIN_ID=admin
ADMIN_EMPLOYEE_ID=00000000-0000-0000-0000-000000000001
ADMIN_EMAIL=admin@proyecto.local

# Bases de datos (una por microservicio)
DB_EMPLEADOS_NAME=empleados
DB_EMPLEADOS_USER=empleados
DB_DEPARTAMENTOS_NAME=departamentos
DB_DEPARTAMENTOS_USER=departamentos
DB_PERFILES_NAME=perfiles
DB_PERFILES_USER=perfiles
DB_NOTIFICACIONES_NAME=notificaciones
DB_NOTIFICACIONES_USER=notificaciones
DB_VACACIONES_NAME=vacaciones
DB_VACACIONES_USER=vacaciones
DB_AUTH_NAME=auth
DB_AUTH_USER=auth

# Aplicación y resiliencia
JWT_ACCESS_TTL_SECONDS=900
JWT_RESET_TTL_SECONDS=1800
GATEWAY_REQUEST_TIMEOUT_SECONDS=20
VACACIONES_SCHEDULER_INTERVAL_SECONDS=5
DEPARTAMENTOS_TIMEOUT_SECONDS=2
DEPARTAMENTOS_MAX_RETRIES=3
DEPARTAMENTOS_BACKOFF_SECONDS=1
DEPARTAMENTOS_CB_FAIL_MAX=3
DEPARTAMENTOS_CB_RESET_TIMEOUT_SECONDS=30
PENDIENTES_RECONCILIATION_INTERVAL_SECONDS=15

# Escalabilidad: réplicas detrás del balanceador (Traefik) y puerto de su panel
EMPLEADOS_REPLICAS=2
DEPARTAMENTOS_REPLICAS=2
LB_DASHBOARD_PORT=8088

# Correo: bandeja web de Mailpit y remitente de las notificaciones
MAILPIT_PORT=8025
NOTIFICACIONES_REMITENTE=rrhh@empresa.local

# Pruebas y caos controlado
POLL_TIMEOUT_SECONDS=30
POLL_INTERVAL_MS=500
POLL_MAX_ATTEMPTS=60
HTTP_TIMEOUT_SECONDS=20
CHAOS_EMPLEADOS_LATENCY_SECONDS=0
CHAOS_DEPARTAMENTOS_LATENCY_SECONDS=0
CHAOS_LATENCY_PROBABILITY=0.5

# CI/CD
SONAR_MIN_COVERAGE=70
SONARQUBE_IMAGE=sonarqube:community
