# Copie este archivo solo para conocer las variables. La forma recomendada es
# ejecutar scripts/setup.ps1 o scripts/setup.sh, que genera .env con secretos aleatorios.

# Puertos publicados en localhost
GATEWAY_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091
ZIPKIN_PORT=9411
RABBITMQ_MANAGEMENT_PORT=15672
JENKINS_PORT=8090
JENKINS_AGENT_PORT=50000
SONAR_PORT=9000
REGISTRY_PORT=5001

# Credenciales: nunca registre valores reales aquí
JWT_SECRET=<generated-by-setup>
RABBITMQ_USER=rrhh
RABBITMQ_PASSWORD=<generated-by-setup>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generated-by-setup>
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=<generated-by-setup>
SONAR_ADMIN_PASSWORD=<generated-by-setup>
SONAR_DB_PASSWORD=<generated-by-setup>
E2E_ADMIN_EMAIL=admin@proyecto.local
E2E_ADMIN_PASSWORD=<generated-by-setup>
ADMIN_EMPLOYEE_ID=00000000-0000-0000-0000-000000000001
ADMIN_EMAIL=admin@proyecto.local
ADMIN_PASSWORD_HASH=<bcrypt-generated-by-setup>
DISCORD_WEBHOOK_URL=

# Bases de datos
DB_EMPLEADOS_NAME=empleados
DB_EMPLEADOS_USER=empleados
DB_EMPLEADOS_PASSWORD=<generated-by-setup>
DB_DEPARTAMENTOS_NAME=departamentos
DB_DEPARTAMENTOS_USER=departamentos
DB_DEPARTAMENTOS_PASSWORD=<generated-by-setup>
DB_PERFILES_NAME=perfiles
DB_PERFILES_USER=perfiles
DB_PERFILES_PASSWORD=<generated-by-setup>
DB_NOTIFICACIONES_NAME=notificaciones
DB_NOTIFICACIONES_USER=notificaciones
DB_NOTIFICACIONES_PASSWORD=<generated-by-setup>
DB_VACACIONES_NAME=vacaciones
DB_VACACIONES_USER=vacaciones
DB_VACACIONES_PASSWORD=<generated-by-setup>
DB_AUTH_NAME=auth
DB_AUTH_USER=auth
DB_AUTH_PASSWORD=<generated-by-setup>

# Aplicación y resiliencia
JWT_ACCESS_TTL_SECONDS=900
JWT_RESET_TTL_SECONDS=1800
GATEWAY_REQUEST_TIMEOUT_SECONDS=20
VACACIONES_SCHEDULER_INTERVAL_SECONDS=5
DEPARTAMENTOS_TIMEOUT_SECONDS=2
DEPARTAMENTOS_MAX_RETRIES=3
DEPARTAMENTOS_BACKOFF_SECONDS=1
DEPARTAMENTOS_CB_FAIL_MAX=3
DEPARTAMENTOS_CB_RESET_TIMEOUT_SECONDS=30
PENDIENTES_RECONCILIATION_INTERVAL_SECONDS=15

# Pruebas y caos controlado
POLL_TIMEOUT_SECONDS=30
POLL_INTERVAL_MS=500
POLL_MAX_ATTEMPTS=60
HTTP_TIMEOUT_SECONDS=20
CHAOS_EMPLEADOS_LATENCY_SECONDS=0
CHAOS_DEPARTAMENTOS_LATENCY_SECONDS=0
CHAOS_LATENCY_PROBABILITY=0.5

# CI/CD
SONAR_MIN_COVERAGE=70
SONARQUBE_IMAGE=sonarqube:community
REPO_URL=file:///repo
REPO_BRANCH=*/main
