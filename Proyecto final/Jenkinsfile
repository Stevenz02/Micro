// Pipeline integral del ecosistema: build + test de los 5 lenguajes -> quality (SonarQube,
// cobertura >= 70 %) -> package (7 imagenes al registry local) -> pruebas BDD de extremo a extremo.
// Cada microservicio tiene ademas su propio pipeline en microservicios/<servicio>/Jenkinsfile.
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  parameters {
    booleanParam(name: 'RUN_E2E', defaultValue: true, description: 'Ejecutar la suite BDD (Behave) contra el sistema desplegado')
  }
  environment {
    CI_VENV = '.ci/venv'
    SONARQUBE_ENV = 'sonarqube-proyecto-final'
  }
  stages {
    stage('Checkout') {
      steps {
        // El proyecto esta montado en /proyecto (solo lectura). Se copia al workspace sin
        // secretos ni artefactos locales: el pipeline nunca ve .env ni secrets/.
        sh '''
          set -eu
          find . -mindepth 1 -maxdepth 1 -exec rm -rf {} +
          tar -C /proyecto --exclude=./secrets --exclude=./.env --exclude=./.git \
              --exclude=node_modules --exclude=target --exclude=bin --exclude=obj \
              --exclude=__pycache__ --exclude=reports --exclude=.ci -cf - . | tar -xf -
        '''
      }
    }
    stage('Build + Test') {
      parallel {
        stage('Python') {
          steps {
            sh '''
              set -eu
              python3 -m venv "$CI_VENV"
              "$CI_VENV/bin/python" -m pip install --disable-pip-version-check -q -r microservicios/requirements-test.txt
              mkdir -p microservicios/reports
              export COVERAGE_FILE="$PWD/microservicios/reports/.coverage"
              PYTHONPATH=microservicios "$CI_VENV/bin/python" -m pytest microservicios/tests -m 'not integration' \
                --cov=microservicios/empleados/app --cov=microservicios/auth/auth_app \
                --cov=microservicios/api-gateway/gateway_app --cov=microservicios/shared \
                --cov-report=term --cov-report=xml:microservicios/reports/python-coverage.xml \
                --junitxml=microservicios/reports/python-junit.xml
            '''
          }
        }
        stage('Node.js') {
          steps {
            dir('microservicios/departamentos') {
              sh '''
                set -eu
                npm ci --no-audit --no-fund
                mkdir -p coverage
                node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' \
                  --test-reporter=spec --test-reporter-destination=stdout \
                  --test-reporter=lcov --test-reporter-destination=coverage/lcov.info
              '''
            }
          }
        }
        stage('Go') {
          steps {
            dir('microservicios/perfiles') {
              sh '''
                set -eu
                go mod tidy
                go vet ./...
                go test -covermode=atomic -coverprofile=coverage.out ./...
              '''
            }
          }
        }
        stage('Java') {
          steps { dir('microservicios/notificaciones') { sh 'mvn -B -ntp verify' } }
        }
        stage('.NET') {
          steps { sh 'dotnet test microservicios/vacaciones.tests/Vacaciones.Tests.csproj --configuration Release' }
        }
      }
    }
    stage('Quality') {
      steps {
        withSonarQubeEnv(env.SONARQUBE_ENV) { sh 'sonar-scanner -Dproject.settings=sonar-project.properties' }
        // Quality Gate "Cobertura 70": por debajo del 70 % el pipeline falla aqui
        timeout(time: 15, unit: 'MINUTES') { waitForQualityGate abortPipeline: true }
      }
    }
    stage('Package') {
      steps {
        sh '''
          set -eu
          publicar() {  # nombre, contexto, Dockerfile
            IMAGE="$REGISTRY_PUSH_HOST/rrhh/$1"
            docker build -q -t "$IMAGE:$BUILD_NUMBER" -t "$IMAGE:latest" -f "$3" "$2"
            docker push -q "$IMAGE:$BUILD_NUMBER"
            docker push -q "$IMAGE:latest"
            echo "Imagen publicada: $IMAGE:$BUILD_NUMBER"
          }
          for servicio in api-gateway auth empleados; do
            publicar "$servicio" microservicios "microservicios/$servicio/Dockerfile"
          done
          for servicio in departamentos perfiles notificaciones vacaciones; do
            publicar "$servicio" "microservicios/$servicio" "microservicios/$servicio/Dockerfile"
          done
        '''
      }
    }
    stage('BDD end-to-end') {
      when { expression { params.RUN_E2E } }
      steps {
        // La suite corre contra el ecosistema desplegado por Docker Compose (misma red Docker).
        // Las credenciales del administrador llegan como credencial de Jenkins (Docker Secret).
        withCredentials([usernamePassword(credentialsId: 'proyecto-final-e2e-admin',
                                          usernameVariable: 'ADMIN_EMAIL', passwordVariable: 'ADMIN_PASSWORD')]) {
          sh '''
            set -eu
            "$CI_VENV/bin/python" -m pip install --disable-pip-version-check -q -r e2e-tests/requirements.txt
            BASE_URL=http://api-gateway:8080 "$CI_VENV/bin/python" e2e-tests/run.py
          '''
        }
      }
    }
  }
  post {
    always {
      junit testResults: 'microservicios/reports/*-junit.xml,microservicios/notificaciones/target/surefire-reports/TEST-*.xml,e2e-tests/reports/junit.xml', allowEmptyResults: true
      archiveArtifacts artifacts: 'microservicios/reports/*.xml,e2e-tests/reports/**', allowEmptyArchive: true
    }
  }
}
