{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": { "()": "shared.observability.JsonFormatter" }
  },
  "filters": {
    "noise": { "()": "shared.observability.NoiseFilter" }
  },
  "handlers": {
    "console": { "class": "logging.StreamHandler", "formatter": "json", "stream": "ext://sys.stdout" },
    "access": { "class": "logging.StreamHandler", "formatter": "json", "filters": ["noise"], "stream": "ext://sys.stdout" }
  },
  "root": { "level": "INFO", "handlers": ["console"] },
  "loggers": {
    "uvicorn": { "level": "INFO", "handlers": ["console"], "propagate": false },
    "uvicorn.error": { "level": "INFO", "handlers": ["console"], "propagate": false },
    "uvicorn.access": { "level": "INFO", "handlers": ["access"], "propagate": false },
    "pika": { "level": "WARNING" },
    "httpx": { "level": "WARNING" }
  }
}
