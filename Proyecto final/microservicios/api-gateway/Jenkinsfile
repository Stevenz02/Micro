// Pipeline de CI de API Gateway (Python/FastAPI): build -> test (cobertura >= 70 %) -> quality (SonarQube) -> package.
// Jenkins lo registra con JCasC (infra/jenkins/casc.yaml) leyendo este archivo.
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  environment {
    SONARQUBE_ENV = 'sonarqube-proyecto-final'
  }
  stages {
    stage('Checkout') {
      steps {
        // El proyecto esta montado en /proyecto (solo lectura). Se copia al workspace sin
        // secretos ni artefactos locales: el pipeline nunca ve .env ni secrets/.
        sh '''
          set -eu
          find . -mindepth 1 -maxdepth 1 -exec rm -rf {} +
          tar -C /proyecto --exclude=./secrets --exclude=./.env --exclude=./.git \
              --exclude=node_modules --exclude=target --exclude=bin --exclude=obj \
              --exclude=__pycache__ --exclude=reports --exclude=.ci -cf - . | tar -xf -
        '''
      }
    }
    stage('Build') {
      steps {
        dir('microservicios') {
          sh '''
            set -eu
            python3 -m venv ../.ci/venv
            ../.ci/venv/bin/python -m pip install --disable-pip-version-check -q -r requirements-test.txt
            ../.ci/venv/bin/python -m compileall -q api-gateway/gateway_app shared
          '''
        }
      }
    }
    stage('Test') {
      steps {
        dir('microservicios') {
          sh '''
            set -eu
            mkdir -p api-gateway/reports
            export COVERAGE_FILE="$PWD/api-gateway/reports/.coverage"
            PYTHONPATH=. ../.ci/venv/bin/python -m pytest tests/test_gateway.py -m 'not integration' \
              --cov=api-gateway/gateway_app --cov-config=api-gateway/.coveragerc \
              --cov-report=term --cov-report=xml:api-gateway/reports/coverage.xml \
              --cov-fail-under=70 --junitxml=api-gateway/reports/junit.xml
          '''
        }
      }
    }
    stage('Quality') {
      steps {
        dir('microservicios') {
          withSonarQubeEnv(env.SONARQUBE_ENV) {
            sh '''
              sonar-scanner -Dproject.settings=api-gateway/sonar-project.properties
            '''
          }
        }
        // Quality Gate "Cobertura 70": si la cobertura cae por debajo del 70 % el pipeline falla
        timeout(time: 10, unit: 'MINUTES') { waitForQualityGate abortPipeline: true }
      }
    }
    stage('Package') {
      steps {
        sh '''
          set -eu
          IMAGE="$REGISTRY_PUSH_HOST/rrhh/api-gateway"
          docker build -t "$IMAGE:$BUILD_NUMBER" -t "$IMAGE:latest" -f microservicios/api-gateway/Dockerfile microservicios
          docker push "$IMAGE:$BUILD_NUMBER"
          docker push "$IMAGE:latest"
          echo "Imagen publicada: $IMAGE:$BUILD_NUMBER"
        '''
      }
    }
  }
  post {
    always {
      junit testResults: 'microservicios/api-gateway/reports/junit.xml', allowEmptyResults: true
      archiveArtifacts artifacts: 'microservicios/api-gateway/reports/*.xml', allowEmptyArchive: true
    }
  }
}
