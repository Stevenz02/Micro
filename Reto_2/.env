# Copiar este archivo como ".env" antes de levantar el sistema
# docker compose lee automáticamente el archivo .env

# Base de datos - Empleados
DB_EMPLEADOS_NAME=empleados_db
DB_EMPLEADOS_USER=empleados_user
DB_EMPLEADOS_PASSWORD=empleados_pass

# Base de datos - Departamentos
DB_DEPARTAMENTOS_NAME=departamentos_db
DB_DEPARTAMENTOS_USER=departamentos_user
DB_DEPARTAMENTOS_PASSWORD=departamentos_pass