# ============================================================
# Reto 7 - Infraestructura CI (copiar a .env: Copy-Item .env.example .env)
# Valores SOLO académicos/locales. El .env no se versiona.
# ============================================================

# --- Jenkins (http://localhost:9090). El usuario lo crea JCasC al arrancar ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=<configure-locally>

# --- SonarQube (http://localhost:9000). sonar-init cambia admin/admin por esta clave ---
SONAR_ADMIN_PASSWORD=<configure-locally>
SONAR_DB_PASSWORD=<configure-locally>
SONAR_MIN_COVERAGE=70
# SONARQUBE_IMAGE=sonarqube:community

# --- Credencial reto7-e2e-admin (ADMIN semilla del sistema, igual que Reto_6/.env.example) ---
E2E_ADMIN_EMAIL=admin@empresa.com
E2E_ADMIN_PASSWORD=<configure-locally>

# --- Repositorio que usan los jobs ---
# file:///repo  = el repo de este PC, montado en Jenkins (toma lo que esté COMMITEADO, sin push)
# Alternativa:    REPO_URL=https://github.com/Stevenz02/Micro.git  (toma lo que esté en GitHub)
REPO_URL=file:///repo
REPO_BRANCH=*/main
