pipeline {
  agent any
  options { skipDefaultCheckout(true); timestamps(); disableConcurrentBuilds() }
  parameters {
    booleanParam(name: 'RUN_PACKAGE', defaultValue: false, description: 'Invoca el job de empaquetado mantenido por infraestructura')
    string(name: 'PACKAGE_JOB', defaultValue: '', description: 'Nombre completo del job externo de Package')
    booleanParam(name: 'TRIGGER_E2E', defaultValue: false, description: 'Dispara una única ejecución coordinada del pipeline E2E')
    string(name: 'E2E_JOB', defaultValue: 'reto7-integracion-e2e', description: 'Job coordinador de BDD')
  }
  environment { CI_VENV = '.ci/venv-auth'; SONARQUBE_ENV = 'sonarqube-reto7' }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build') {
      steps {
        sh '''
          set -eu
          python3 -m venv "$CI_VENV"
          "$CI_VENV/bin/python" -m pip install --disable-pip-version-check -r Reto_5/requirements-test.txt
          "$CI_VENV/bin/python" -m compileall -q Reto_5/auth/auth_app Reto_5/shared
        '''
      }
    }
    stage('Test + Coverage') {
      steps {
        script { env.TESTS_STARTED = 'true' }
        sh '''
          set -eu
          mkdir -p Reto_5/auth/reports
          export COVERAGE_FILE="$WORKSPACE/Reto_5/auth/reports/.coverage"
          "$CI_VENV/bin/python" -m pytest Reto_5/tests/test_auth.py \
            --cov=auth_app.passwords --cov=auth_app.lifecycle --cov=shared.tokens \
            --cov-report=xml:Reto_5/auth/reports/coverage.xml \
            --junitxml=Reto_5/auth/reports/junit.xml
        '''
      }
    }
    stage('SonarQube Analysis') {
      steps { withSonarQubeEnv(env.SONARQUBE_ENV) { sh 'sonar-scanner -Dproject.settings=Reto_7/ci/config/sonar/auth.properties' } }
    }
    stage('Quality Gate') { steps { timeout(time: 10, unit: 'MINUTES') { waitForQualityGate abortPipeline: true } } }
    stage('Package') {
      when { expression { params.RUN_PACKAGE } }
      steps { script {
        if (!params.PACKAGE_JOB?.trim()) { error('RUN_PACKAGE=true requiere PACKAGE_JOB; infraestructura debe aprovisionarlo') }
        build job: params.PACKAGE_JOB.trim(), wait: true, propagate: true, parameters: [
          string(name: 'COMPONENT_ID', value: 'auth'), string(name: 'SOURCE_DIR', value: 'Reto_5/auth'), string(name: 'SOURCE_BUILD', value: env.BUILD_NUMBER)
        ]
      } }
    }
    stage('E2E Tests') {
      when { expression { params.TRIGGER_E2E } }
      steps { build job: params.E2E_JOB, wait: true, propagate: true, parameters: [string(name: 'UPSTREAM_COMPONENT', value: 'auth'), string(name: 'UPSTREAM_BUILD', value: env.BUILD_NUMBER)] }
    }
  }
  post {
    always { script { if (env.TESTS_STARTED == 'true') {
      junit testResults: 'Reto_5/auth/reports/junit.xml', allowEmptyResults: false
      recordCoverage tools: [[parser: 'COBERTURA', pattern: 'Reto_5/auth/reports/coverage.xml']], id: 'auth', name: 'Cobertura Auth', sourceCodeRetention: 'LAST_BUILD'
      archiveArtifacts artifacts: 'Reto_5/auth/reports/junit.xml,Reto_5/auth/reports/coverage.xml', allowEmptyArchive: false
    } } }
    cleanup { deleteDir() }
  }
}

