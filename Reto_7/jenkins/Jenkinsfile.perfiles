pipeline {
  agent any
  options { skipDefaultCheckout(true); timestamps(); disableConcurrentBuilds() }
  parameters {
    booleanParam(name: 'RUN_PACKAGE', defaultValue: false, description: 'Invoca el job de empaquetado mantenido por infraestructura')
    string(name: 'PACKAGE_JOB', defaultValue: '', description: 'Nombre completo del job externo de Package')
    booleanParam(name: 'TRIGGER_E2E', defaultValue: false, description: 'Dispara una única ejecución coordinada del pipeline E2E')
    string(name: 'E2E_JOB', defaultValue: 'reto7-integracion-e2e', description: 'Job coordinador de BDD')
  }
  environment { SONARQUBE_ENV = 'sonarqube-reto7' }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build') { steps { dir('Reto_4/perfiles') { sh 'go mod download && go build ./...' } } }
    stage('Test + Coverage') {
      steps {
        script {
          env.TESTS_STARTED = 'true'
          sh 'mkdir -p Reto_4/perfiles/reports'
          int testStatus = sh(
            returnStatus: true,
            script: "cd Reto_4/perfiles && go test -json -covermode=atomic -coverprofile=reports/coverage.out ./... > reports/test-results.json"
          )
          sh '''
            python3 Reto_7/ci/scripts/go_test_json_to_junit.py \
              --input Reto_4/perfiles/reports/test-results.json \
              --output Reto_4/perfiles/reports/junit.xml
            python3 Reto_7/ci/scripts/go_cover_to_cobertura.py \
              --input Reto_4/perfiles/reports/coverage.out \
              --output Reto_4/perfiles/reports/coverage.xml \
              --source Reto_4/perfiles
          '''
          int reportStatus = sh(
            returnStatus: true,
            script: "python3 Reto_7/ci/scripts/junit_status.py --glob 'Reto_4/perfiles/reports/junit.xml'"
          )
          if (testStatus != 0) { error("go test falló con código ${testStatus}; los reportes fueron conservados") }
          if (reportStatus != 0) { error("El JUnit Go contiene fallos, errores o está incompleto; código ${reportStatus}") }
        }
      }
    }
    stage('SonarQube Analysis') {
      steps { withSonarQubeEnv(env.SONARQUBE_ENV) { sh 'sonar-scanner -Dproject.settings=Reto_7/ci/config/sonar/perfiles.properties' } }
    }
    stage('Quality Gate') { steps { timeout(time: 10, unit: 'MINUTES') { waitForQualityGate abortPipeline: true } } }
    stage('Package') {
      when { expression { params.RUN_PACKAGE } }
      steps { script {
        if (!params.PACKAGE_JOB?.trim()) { error('RUN_PACKAGE=true requiere PACKAGE_JOB; infraestructura debe aprovisionarlo') }
        build job: params.PACKAGE_JOB.trim(), wait: true, propagate: true, parameters: [
          string(name: 'COMPONENT_ID', value: 'perfiles'), string(name: 'SOURCE_DIR', value: 'Reto_4/perfiles'), string(name: 'SOURCE_BUILD', value: env.BUILD_NUMBER)
        ]
      } }
    }
    stage('E2E Tests') {
      when { expression { params.TRIGGER_E2E } }
      steps { build job: params.E2E_JOB, wait: true, propagate: true, parameters: [string(name: 'UPSTREAM_COMPONENT', value: 'perfiles'), string(name: 'UPSTREAM_BUILD', value: env.BUILD_NUMBER)] }
    }
  }
  post {
    always { script { if (env.TESTS_STARTED == 'true') {
      junit testResults: 'Reto_4/perfiles/reports/junit.xml', allowEmptyResults: false
      recordCoverage tools: [[parser: 'COBERTURA', pattern: 'Reto_4/perfiles/reports/coverage.xml']], id: 'perfiles', name: 'Cobertura Perfiles', sourceCodeRetention: 'LAST_BUILD'
      archiveArtifacts artifacts: 'Reto_4/perfiles/reports/junit.xml,Reto_4/perfiles/reports/coverage.xml,Reto_4/perfiles/reports/coverage.out,Reto_4/perfiles/reports/test-results.json', allowEmptyArchive: false
    } } }
    cleanup { deleteDir() }
  }
}
